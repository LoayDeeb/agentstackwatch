---
import '@fontsource-variable/newsreader'; import '@fontsource-variable/newsreader/wght-italic.css'; import '@fontsource-variable/inter';
const { title = 'AgentStackWatch — the AI agent stack, tracked', desc = 'A publication tracking what shipped, what broke and what got cheaper across AI agents, platforms and frameworks.', og = 'home', wide = false } = Astro.props;
const ogUrl = new URL(`/og/${og}.png`, Astro.site); const path = Astro.url.pathname;
const nav=[['/','Home'],['/posts/','Writing'],['/landscape/','Landscape'],['/tracker/','Tracker'],['/changes/','Changes']];
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title}</title><meta name="description" content={desc}/>
<meta property="og:title" content={title}/><meta property="og:description" content={desc}/><meta property="og:image" content={ogUrl}/><meta name="twitter:card" content="summary_large_image"/>
<link rel="alternate" type="application/rss+xml" title="AgentStackWatch" href="/rss.xml"/><link rel="icon" href="/favicon.svg"/>
<script is:inline>document.documentElement.dataset.theme=localStorage.theme||'light'</script>
<link rel="stylesheet" href="/style.css"/></head>
<body>
<header class="mast"><div class="shell mrow">
 <a class="brand" href="/"><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><circle cx="11" cy="11" r="10" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="11" cy="11" r="4" fill="var(--acc)"/></svg>AgentStack<i>Watch</i></a>
 <nav>{nav.map(([h,l])=> <a href={h} class={path===h||(h!=='/'&&path.startsWith(h))?'on':''}>{l}</a>)}</nav>
 <div class="mtools"><a href="/search/" class="ic" aria-label="Search">⌕</a><button class="ic" id="tt" aria-label="Toggle dark mode">◐</button><a class="subbtn" href="/newsletter/">Subscribe</a></div>
</div></header>
<main class={wide?'shell':'shell'} data-pagefind-body><slot/></main>
<footer class="foot"><div class="shell frow"><div><a class="brand" href="/">AgentStack<i>Watch</i></a><p>An independent publication on the AI agent stack.<br/>Every tracker fact links to a source. Unverified fields read <em>unknown</em>.</p></div>
<div class="fl"><a href="/posts/">Writing</a><a href="/landscape/">Landscape</a><a href="/tracker/">Tracker</a><a href="/changes/">Changes</a><a href="/featured/">Featured listings</a><a href="/rss.xml">RSS</a></div></div></footer>
<script is:inline>document.getElementById('tt').onclick=()=>{const t=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=t;localStorage.theme=t};
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{rootMargin:'0px 0px -8% 0px'});document.querySelectorAll('.rv').forEach(el=>io.observe(el));</script>
</body></html>
