---
import Base from './Base.astro'; import Signup from '../components/Signup.astro'; import { ALL } from '../lib/cite.js'; import guides from '../lib/guides.json';
const { slug, title, desc, h1, kicker, dek, faqs = [], used = [], related = [], updated = '2026-10-17' } = Astro.props;
const url = `https://agentstackwatch.com/${slug}/`;
const ld = [{"@context":"https://schema.org","@type":"FAQPage","mainEntity":faqs.map(([q,a])=>({"@type":"Question","name":q,"acceptedAnswer":{"@type":"Answer","text":a.replace(/<a class="cite"[^>]*>\d+<\/a>/g,'').replace(/<[^>]+>/g,'')}}))},
 {"@context":"https://schema.org","@type":"Article","headline":h1,"description":desc,"author":{"@type":"Person","name":"Loay Deeb","jobTitle":"AI agent architect"},"datePublished":updated,"dateModified":updated,"publisher":{"@type":"Organization","name":"AgentStackWatch"},"mainEntityOfPage":url},
 {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Guides","item":"https://agentstackwatch.com/guides/"},{"@type":"ListItem","position":2,"name":h1,"item":url}]}];
const D = new Date(updated+'T12:00:00Z').toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'});
const more = guides.filter(g=>g.slug!==slug);
---
<Base title={title} desc={desc} og={`guides-${slug}`} ogType="article">
<Fragment slot="head"><link rel="canonical" href={url}/><meta name="author" content="Loay Deeb"/>
<script type="application/ld+json" set:html={JSON.stringify(ld)}/></Fragment>
<article class="guide ga">
<header class="pagehead ghead"><p class="kicker"><a href="/guides/">Guides</a> · {kicker}</p><h1>{h1}</h1><p class="dek" set:html={dek}/>
<p class="byline">By <b>Loay Deeb</b>, AI agent architect · Updated {D} · Every fact links to its source; anything we couldn't verify says <span class="unk">unknown</span>.</p></header>
<div class="gsign"><Signup variant="inline"/></div>
<div class="gbody"><slot/></div>
<section class="gsec" id="faq"><p class="kicker">FAQ</p><h2>Questions people ask</h2><div class="faq">{faqs.map(([q,a])=> <details open><summary>{q}</summary><p set:html={a}/></details>)}</div></section>
<section class="gsec"><p class="kicker">Keep reading</p><h2>Related</h2><ul class="rel">
<li><a href="/guide/">The Personal AI Agent Buyer's Guide (2026)</a>: eleven agents, by job, with security and cost tables.</li>
<li><a href="/pricing/">AI agent pricing</a>: every plan, linked to the vendor's page with the date checked.</li>
{related.map(([h,l])=> <li><a href={h}>{l}</a></li>)}
<li><a href="/compare/">All head-to-head comparisons</a></li></ul>
<p class="muted small">More guides: <Fragment set:html={more.map(g=>`<a href="/${g.slug}/">${g.short}</a>`).join(' · ')}/> · <a href="/guides/">all guides</a></p></section>
<section class="gsec gctasec"><h2>Get the weekly agent briefing</h2><p>One email a week: what shipped, what broke and what got cheaper across AI agents, plus hands-on tests on real tasks at work and at home.</p></section>
<div class="gsign"><Signup variant="feature"/></div>
<section class="gsec" id="sources"><p class="kicker">Sources</p><h2>Where these facts come from</h2>
<p class="muted small">We read each vendor's own pricing page, help center, docs or release notes. No review sites, no paid placement. Research and drafting were assisted by an AI agent (Grok Bot, one of the products covered); every fact was checked against the linked source.</p>
<ol class="gsrc">{used.map(k=> <li><a href={ALL[k].u} target="_blank" rel="noopener">{ALL[k].t}</a> <span class="muted small">{ALL[k].u.replace(/^https?:\/\//,'')} · checked {ALL[k].d}</span></li>)}</ol></section>
</article>
<style is:global>
.ga .ghead h1{max-width:22ch}.ga .ghead .kicker a{color:inherit}.ga .byline{margin-top:10px;font-size:14px}
.gsign{margin:28px 0;overflow:hidden}.gsign .signup{margin:0}.gsec{padding:40px 0;border-top:1px solid var(--line)}.gsec h2{font:500 clamp(26px,4vw,38px)/1.12 var(--serif);margin:0 0 18px;letter-spacing:-.01em}
.gbody{max-width:760px;min-width:0}.gbody pre.code{overflow-x:auto;max-width:100%;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px 16px;font:400 13px/1.5 var(--mono)}.gbody code{font-family:var(--mono);font-size:.88em;overflow-wrap:anywhere}.gbody pre code{overflow-wrap:normal;font-size:13px}.gbody p,.gbody li{font:400 18px/1.65 var(--serif);color:var(--ink2)}.gbody h2{font:500 clamp(26px,4vw,36px)/1.15 var(--serif);margin:44px 0 14px;letter-spacing:-.01em}.gbody h3{font:600 17px/1.3 var(--sans);margin:26px 0 8px}
.gbody a:not(.cite){text-decoration:underline;text-decoration-color:var(--acc);text-underline-offset:3px}.gbody li{margin:8px 0}.gbody .gtable-wrap{margin:18px 0}
.gtable-wrap{overflow-x:auto;max-width:100%}.gtab{width:100%;border-collapse:collapse;font:400 14.5px/1.5 var(--sans)}.gtab th{text-align:left;font:600 11.5px/1.2 var(--sans);letter-spacing:.08em;text-transform:uppercase;color:var(--mut);padding:10px 12px;border-bottom:1px solid var(--ink)}
.gtab td{padding:12px;border-bottom:1px solid var(--line);vertical-align:top;font:400 14.5px/1.5 var(--sans)}.gtab td.nm{font-weight:600}.gtab .mono{font-family:var(--mono,ui-monospace,monospace);white-space:nowrap}
a.cite{display:inline-block;font:600 10px/1 var(--sans);color:var(--acc);background:var(--acc-s);border-radius:4px;padding:2px 4px;margin-left:3px;vertical-align:super;text-decoration:none}a.cite:hover{background:var(--acc);color:#fff}
.tldr{background:var(--card);border:1px solid var(--line);border-left:3px solid var(--acc);border-radius:12px;padding:16px 20px;margin:8px 0 10px}.tldr p,.tldr li{font:400 16px/1.6 var(--sans)!important}.tldr ul{margin:6px 0 0;padding-left:18px}
.faq details{border:1px solid var(--line);border-radius:12px;padding:14px 18px;margin:10px 0;background:var(--card);max-width:760px}.faq summary{font:600 16px/1.4 var(--sans);cursor:pointer}.faq p{margin:10px 0 0;font:400 15.5px/1.6 var(--sans);color:var(--ink2)}
.rel{padding-left:18px}.rel li{margin:8px 0}.rel a,.ga .muted a{text-decoration:underline}.gsrc{font-size:14px;padding-left:22px}.gsrc li{margin:6px 0;overflow-wrap:anywhere}.gsrc a{text-decoration:underline}.gctasec{text-align:center}.gctasec p{max-width:620px;margin:0 auto}
@media(max-width:720px){.gsec{padding:30px 0}.gbody p,.gbody li{font-size:17px}.gtab thead{display:none}.gtab,.gtab tbody,.gtab tr,.gtab td{display:block;width:100%}.gtab tr{border:1px solid var(--line);border-radius:12px;padding:6px 14px;margin-bottom:12px;background:var(--card)}
.gtab td{border:0;padding:6px 0}.gtab td::before{content:attr(data-l);display:block;font:600 10.5px/1.4 var(--sans);letter-spacing:.08em;text-transform:uppercase;color:var(--mut)}.gtab .mono{white-space:normal}}
</style>
</Base>
