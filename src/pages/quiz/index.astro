---
import Base from '../../layouts/Base.astro'; import Signup from '../../components/Signup.astro'; import { ALL } from '../../lib/cite.js';
// Every "why" line restates a fact already published on our guides; src keys resolve to the same vendor pages those guides cite.
const P = {
 chatgptplus:{n:'ChatGPT Plus',w:['$20 a month. Includes deep research and ChatGPT Work for finished reports, and it can book and fill in forms for you.','Covers Gmail and Outlook, so it fits whichever email you use.'],src:['oai-plus6','oai-pricing6'],g:[['/best-ai-agent-for-personal-use/','Best AI agent for personal use'],['/chatgpt-vs-gemini/','ChatGPT vs Gemini']]},
 chatgptfree:{n:'ChatGPT Free',w:['Text chats are unlimited within fair-use rules; uploads, images, voice and deep research are limited.','The catch: ads may appear on the free plan.'],src:['oai-pricing6','oai-go6'],g:[['/best-free-ai-agent/','Best free AI agents'],['/chatgpt-vs-gemini/','ChatGPT vs Gemini']]},
 claudepro:{n:'Claude Pro',w:['$20 a month, or $17 a month billed yearly. Adds task hand-off, scheduling and Research.','Has the most detailed published Gmail and Google Calendar features in our email guide, and asks before sending by default.'],src:['cl-pricing6'],g:[['/ai-agent-for-email-and-calendar/','AI agent for email and calendar'],['/claude-vs-gemini/','Claude vs Gemini']]},
 claudefree:{n:'Claude Free',w:['Free Claude can search the web, create files, remember across chats and connect to your apps.','Training is opt-out on the free plan, and Incognito chats are never used for training.'],src:['cl-pricing6','cl-train6'],g:[['/best-free-ai-agent/','Best free AI agents'],['/claude-vs-gemini/','Claude vs Gemini']]},
 gemini:{n:'Gemini (free, then Google AI Plus)',w:['The free Gemini app includes Deep Research and Gemini Live. Google AI Plus, at $4.99 a month, adds Gemini in Gmail.','Gemini in Docs and Sheets needs Google AI Pro.'],src:['g-overview6','g-plans6'],g:[['/chatgpt-vs-gemini/','ChatGPT vs Gemini'],['/best-free-ai-agent/','Best free AI agents']]},
 copilot:{n:'Microsoft Copilot (Microsoft 365 Personal)',w:['Copilot is free on the web and phones; Microsoft 365 Personal at $9.99 a month puts it inside Word, Excel, PowerPoint and Outlook.','It is the natural pick if your mail lives in Outlook.'],src:['ms-ind6','ms-free6'],g:[['/ai-agent-for-email-and-calendar/','AI agent for email and calendar'],['/best-free-ai-agent/','Best free AI agents']]},
 grokbot:{n:'Grok Bot',w:['An always-on agent that works on its own cloud computer. It needs the X Subscription\'s Premium plan ($30 a month) or higher.','Worth it once you have errands or research worth handing off every week. It also has a "Sales Outbound" job for prospect research.'],src:['x-pricing6','gb-docs6','gb-page6'],g:[['/best-personal-ai-agent-for-founders/','Best personal AI agent for founders'],['/tests/chatgpt-assistant-vs-grok-bot/','Our test: ChatGPT vs Grok Bot']]},
 fin:{n:'Intercom Fin',w:['An AI agent that answers your customers. It charges $0.99 per resolved outcome.','It also works on top of other helpdesks, so you don\'t have to switch tools.'],src:['ic-pricing'],g:[['/best-ai-agent-for-customer-support/','Best AI agent for customer support']]},
 agentforce:{n:'Salesforce Agentforce',w:['If your CRM is Salesforce, the Sales add-on ($125 per user a month) keeps the agent inside your data.','It\'s the priciest option here, built for teams already on Salesforce.'],src:['sf-agentforce'],g:[['/best-ai-agent-for-sales-and-crm/','Best AI agent for sales and CRM']]},
 business:{n:'ChatGPT Business or Claude Team',w:['Buy a business plan, not personal ones, for staff. Expect about $20–30 per person a month.','OpenAI doesn\'t train on ChatGPT Business workspaces by default, and Claude Team doesn\'t either.'],src:['oai-data6','cl-pricing6'],g:[['/best-ai-agent-for-small-business/','Best AI agent for small business'],['/chatgpt-vs-claude-for-business/','ChatGPT vs Claude for business']]},
 opensource:{n:'OpenClaw or Hermes Agent (free software)',w:['Open source with no subscription for the software. OpenClaw runs on your own computer and keeps its data there.','You still pay for the AI model you connect unless you pick a free one, and setup takes some tech comfort.'],src:['oc6','hm6'],g:[['/openclaw-vs-hermes-agent/','OpenClaw vs Hermes Agent'],['/is-openclaw-safe/','Is OpenClaw safe?']]},
};
for (const k in P) P[k].src = P[k].src.map(s=>{ if(!ALL[s]) throw new Error('missing source '+s); return {u:ALL[s].u,t:ALL[s].t}; });
const Qs = [
 ['use','Is this for work or personal life?',[['biz','My business or team'],['solo','My own work (founder, freelancer)'],['personal','Personal life']]],
 ['job','What do you most want help with?',[['email','Email and calendar'],['research','Research'],['support','Customer support'],['sales','Sales and CRM'],['general','General help with everything']]],
 ['budget','What can you spend each month?',[['free','Nothing, free only'],['20','About $20'],['more','More, if it\'s worth it']]],
 ['tech','How comfortable are you with tech?',[['low','Keep it simple'],['mid','I can follow setup steps'],['high','I like tinkering and self-hosting']]],
 ['privacy','How much does privacy matter?',[['normal','Normal: I\'ll check the settings'],['high','High: my data must not train AI']]],
 ['stack','What do you already use?',[['google','Google (Gmail, Drive, Android)'],['microsoft','Microsoft (Outlook, Word, Excel)'],['apple','Apple (iCloud, iPhone, Mac)'],['none','A mix, or none of these']]],
];
const title = "Which AI agent should you use? Take the 1-minute quiz | AgentStackWatch";
const desc = "Six plain questions about your work, budget, privacy and the apps you use. Get a top pick and a runner-up, based only on facts in our sourced guides.";
---
<Base title={title} desc={desc} og="quiz">
<Fragment slot="head"><link rel="canonical" href="https://agentstackwatch.com/quiz/"/></Fragment>
<div class="qz">
<header class="pagehead"><p class="kicker">1-minute quiz</p><h1>Which AI agent should you use?</h1><p class="dek">Six plain questions. You get a top pick and a runner-up, with the reasons and links to the guides behind them. Every recommendation comes from facts already in our guides.</p></header>
<form id="quiz" class="qform">
{Qs.map(([id,q,opts],i)=> <fieldset class="qq"><legend><span class="qn">{i+1}/{Qs.length}</span> {q}</legend><div class="qopts">{opts.map(([v,l])=> <label class="qo"><input type="radio" name={id} value={v} required/><span>{l}</span></label>)}</div></fieldset>)}
<p class="qerr" id="qerr" hidden>Please answer every question.</p>
<button type="submit" class="qbtn">Show my pick →</button>
</form>
<section id="result" class="qres" hidden aria-live="polite"></section>
<div id="qsign" hidden><Signup variant="feature" kicker="Free · weekly" title="Get the full buyer's guide and weekly agent tests" text="One email a week: hands-on agent tests, plus what changed in AI agent prices and features. Every fact sourced."/></div>
<p class="muted small">Recommendations use only facts from our <a href="/guides/">guides</a> and <a href="/pricing/">pricing page</a>, each linked to the vendor's page. Nothing here is paid placement. We have no Apple-specific facts yet, so Apple users get picks based on their other answers.</p>
</div>
<script define:vars={{P}} is:inline>
var f=document.getElementById('quiz'),out=document.getElementById('result'),sg=document.getElementById('qsign');
function score(a){var s={};for(var k in P)s[k]=0;function add(k,n){s[k]+=n}
 // Job
 if(a.job==='email'){add('claudepro',4);add('chatgptplus',3);add('copilot',3);add('gemini',2)}
 if(a.job==='research'){add('chatgptplus',4);add('gemini',3);add('grokbot',2);add('claudepro',2)}
 if(a.job==='support'){add('fin',a.use==='personal'?0:8);add('chatgptplus',2);add('grokbot',2)}
 if(a.job==='sales'){add('grokbot',4);add('chatgptplus',3);add('agentforce',a.use==='biz'?3:0)}
 if(a.job==='general'){add('chatgptplus',4);add('claudepro',3);add('chatgptfree',2);add('gemini',2)}
 // Use
 if(a.use==='biz'){add('business',5);add('chatgptfree',-3);add('claudefree',-3);add('opensource',-1)}
 if(a.use==='solo'){add('grokbot',2);add('chatgptplus',1)}
 if(a.use==='personal'){add('chatgptplus',1);add('agentforce',-9);add('business',-9)}
 // Budget
 if(a.budget==='free'){add('chatgptfree',6);add('claudefree',5);add('gemini',5);add('copilot',2);add('opensource',2);['chatgptplus','claudepro','grokbot','agentforce','business'].forEach(function(k){add(k,-8)});add('fin',-3)}
 if(a.budget==='20'){add('chatgptplus',2);add('claudepro',2);add('copilot',1);add('gemini',1);add('grokbot',-3);add('agentforce',-6)}
 if(a.budget==='more'){add('grokbot',3);add('agentforce',1);add('chatgptfree',-2);add('claudefree',-2)}
 // Tech
 if(a.tech==='high'){add('opensource',a.budget==='free'?5:3)}
 if(a.tech==='low'){add('opensource',-8)}
 if(a.tech==='mid'){add('opensource',-2)}
 // Privacy
 if(a.privacy==='high'){add('business',3);add('opensource',2);add('claudefree',1);add('chatgptfree',-2)}
 // Stack
 if(a.stack==='google'){add('gemini',4);add('claudepro',1);add('copilot',-3)}
 if(a.stack==='microsoft'){add('copilot',5);add('gemini',-2)}
 return Object.keys(s).sort(function(x,y){return s[y]-s[x]})}
function esc(t){return String(t).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
function card(k,label){var p=P[k];return '<div class="qcard'+(label==='Top pick'?' top':'')+'"><p class="kicker">'+label+'</p><h2>'+esc(p.n)+'</h2><p>'+esc(p.w[0])+'</p><p>'+esc(p.w[1])+'</p><p class="qsrc">Sources: '+p.src.map(function(s){return '<a href="'+s.u+'" target="_blank" rel="noopener">'+esc(s.t)+'</a>'}).join(' · ')+'</p><p class="qg">Read: '+p.g.map(function(g){return '<a href="'+g[0]+'">'+esc(g[1])+' →</a>'}).join(' ')+'</p></div>'}
f.addEventListener('submit',function(e){e.preventDefault();var a={},ok=true;['use','job','budget','tech','privacy','stack'].forEach(function(n){var v=f.querySelector('input[name="'+n+'"]:checked');if(!v)ok=false;else a[n]=v.value});
 document.getElementById('qerr').hidden=ok;if(!ok)return;var r=score(a);
 out.innerHTML='<p class="kicker">Your result</p>'+card(r[0],'Top pick')+card(r[1],'Runner-up')+'<p class="qmore">Compare every plan on <a href="/pricing/">our pricing page</a> or read <a href="/guide/">the full buyer\'s guide</a>. <button type="button" class="qagain" id="qagain">Retake the quiz</button></p>';
 out.hidden=false;sg.hidden=false;out.scrollIntoView({behavior:'smooth',block:'start'});
 document.getElementById('qagain').onclick=function(){f.reset();out.hidden=true;window.scrollTo({top:0,behavior:'smooth'})}});
</script>
<style is:global>
.qz{max-width:760px;overflow-x:hidden}.qz *{box-sizing:border-box}.qform{margin:10px 0 24px}
.qq{border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin:0 0 14px;background:var(--card);min-width:0}.qq legend{font:600 17px/1.35 var(--sans);padding:0 6px}.qn{color:var(--acc);font-size:13px;margin-right:4px}
.qopts{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}.qo{display:flex;align-items:center;gap:8px;border:1px solid var(--line);border-radius:999px;padding:9px 14px;cursor:pointer;font:400 15px/1.3 var(--sans);max-width:100%}.qo:has(input:checked){border-color:var(--acc);background:var(--acc-s)}.qo input{accent-color:var(--acc);margin:0}
.qbtn,.qagain{background:var(--acc);color:#fff;border:0;font:600 16px/1.3 var(--sans);padding:14px 22px;border-radius:999px;cursor:pointer}.qagain{font-size:14px;padding:9px 16px;margin-left:6px}.qerr{color:#c0392b;font-weight:600}
.qres{margin:10px 0 24px}.qcard{border:1px solid var(--line);border-radius:14px;padding:18px 20px;margin:12px 0;background:var(--card);overflow-wrap:anywhere}.qcard.top{border:2px solid var(--acc)}.qcard h2{font:500 28px/1.2 var(--serif);margin:4px 0 8px}.qcard .kicker{margin:0;color:var(--acc)}.qcard p{font:400 16px/1.55 var(--sans);margin:6px 0}
.qsrc{font-size:13px!important;color:var(--mut)}.qsrc a,.qg a,.qmore a,.qz .muted a{text-decoration:underline}.qg a{margin-right:10px;display:inline-block}
#qsign{overflow:hidden;margin:20px 0}
@media(max-width:520px){.qo{flex:1 1 100%;border-radius:12px}.qq{padding:14px 12px}}
</style>
</Base>
