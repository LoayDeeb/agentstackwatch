---
import Base from '../layouts/Base.astro'; import Signup from '../components/Signup.astro'; import Ticker from '../components/Ticker.astro';
import Landscape from '../components/Landscape.astro'; import Sparkline from '../components/Sparkline.astro';
import { getPosts, pdate } from '../lib/posts.js'; import { getNews } from '../lib/news.js'; import { all, CATS, movers, releases, fmt } from '../lib/data.js';
const posts = await getPosts(); const news = (await getNews()).slice(0,3); const [lead, ...rest] = posts;
const verified = all.filter(e=>e.status==='verified').length; const repoV = all.filter(e=>e.status==='repo-verified').length; const stars = all.reduce((a,e)=>a+(e.stats.stars||0),0);
const top = [...all].filter(e=>e.stats.downloads_weekly).sort((a,b)=>b.stats.downloads_weekly.at(-1).n-a.stats.downloads_weekly.at(-1).n).slice(0,6);
const pct = g => (g>=0?'+':'')+(g*100).toFixed(0)+'%';
---
<Base>
<section class="hero"><p class="eyebrow rv">Free weekly briefing · {pdate(new Date())}</p>
<h1 class="rv">Which AI agent is <em>worth paying</em> for?</h1>
<p class="dek rv">ChatGPT, Claude, Gemini, Grok Bot, Copilot and the rest change their plans and prices every week. We read the fine print so you don't. Get the free <b>Personal Agent Cheat Sheet</b> (which AI agent to pay for, in 2 minutes), then one 5-minute email a week on what changed and what to actually do.</p>
<div class="rv in"><Signup variant="hero" eager/></div>
<p class="hero-alt rv">Not ready to subscribe? <a href="/cheat-sheet/">Read the cheat sheet</a> · <a href="/quiz/">take the 1-minute quiz</a> · <a href="/guide/">the full buyer's guide</a></p>
<div class="hero-meta rv"><span><b>{all.length}</b> AI products tracked</span><span><b>{verified + repoV}</b> checked against their own sources</span><span>Updated every night</span><span>By Loay Deeb, AI agent architect</span></div></section>
<style>.hero h1{font-size:clamp(44px,7.4vw,96px)}.hero-alt{margin:6px 0 0;font-size:14.5px;color:var(--mut)}.hero-alt a{color:var(--ink);text-decoration:underline;text-decoration-color:var(--acc);text-underline-offset:3px}.hero .dek b{color:var(--ink)}</style>
<Ticker/>
<section class="sect rv latest-news"><div class="sect-h"><p class="kicker">Latest news</p><h2>What changed in AI agents</h2><a href="/news/" class="more">All news →</a></div>
<div class="lnews">{news.map(n=> <a href={`/news/${n.slug}/`} class="ln"><p class="date">{pdate(n.data.date)}</p><h3>{n.data.title}</h3><p>{n.data.summary}</p></a>)}</div></section>
<style>.lnews{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.ln{display:block;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;min-width:0}.ln:hover{border-color:var(--acc)}.ln h3{font:500 21px/1.25 var(--serif);margin:4px 0 8px}.ln p{margin:0;font-size:14.5px;color:var(--ink2)}.ln .date{font-size:12px;color:var(--mut);margin-bottom:4px}@media(max-width:820px){.lnews{grid-template-columns:1fr}}</style>
<section class="front">
 <div class="lead-story rv">{lead && <a href={`/posts/${lead.slug}/`} class="story"><p class="date">{pdate(lead.data.date)} {lead.data.draft && <span class="draft">Draft</span>}</p><h2>{lead.data.title}</h2><p class="dek sm">{lead.data.summary}</p><span class="more">Read the issue →</span></a>}
 {rest.map(p=> <a href={`/posts/${p.slug}/`} class="story s2"><p class="date">{pdate(p.data.date)}</p><h3>{p.data.title}</h3></a>)}</div>
 <aside class="rail rv"><p class="kicker">Most downloaded this week</p>
 <ol class="movers">{top.map((e,i)=> <li><a href={`/agents/${e.slug}/`}><span class="rk">{String(i+1).padStart(2,'0')}</span><span class="nm">{e.name}<small>{fmt(e.stats.downloads_weekly.at(-1).n)} / wk · {e.stats.downloads_source}</small></span><Sparkline series={e.stats.downloads_weekly}/></a></li>)}</ol>
 <p class="kicker mt">Fastest growing · 12 weeks</p>
 <ol class="movers g">{movers.slice(0,4).map(({e,g})=> <li><a href={`/agents/${e.slug}/`}><span class="nm">{e.name}</span><span class={g>=0?'pos':'neg'}>{pct(g)}</span></a></li>)}</ol>
 <p class="small muted">Weekly downloads from PyPI (without mirrors) and npm.</p></aside>
</section>
<Signup variant="feature" title="One 5-minute email a week. Know what changed and what to do."/>
<section class="sect rv"><div class="sect-h"><p class="kicker">The landscape</p><h2>Who's building the agent stack</h2><a href="/landscape/" class="more">Open full map →</a></div><Landscape compact/></section>
<section class="sect rv"><div class="sect-h"><p class="kicker">The tracker</p><h2>Four corners of the stack</h2><a href="/tracker/" class="more">Browse all {all.length} →</a></div>
<div class="quad">{Object.entries(CATS).map(([k,c])=> <a href={`/category/${k}/`} class="qc"><span class={`sw c-${k}`}></span><h3>{c.name}</h3><p>{c.blurb}</p><small>{all.filter(e=>e.category===k).length} entries</small></a>)}</div></section>
</Base>
