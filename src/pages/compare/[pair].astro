---
import Base from '../../layouts/Base.astro'; import Signup from '../../components/Signup.astro'; import { PAIRS, bySlug, fmt, d, pricing, breaking } from '../../lib/data.js';
export function getStaticPaths(){ return PAIRS.map(([a,b])=>({params:{pair:`${a}-vs-${b}`},props:{a:bySlug[a],b:bySlug[b]}})); }
const { a, b } = Astro.props; const u=v=>(v==null||v==='unknown')?'unknown':String(v);
const rows=[['Maker',x=>u(x.maker)],['Pricing',x=>u(x.pricing)],['Open source',x=>x.open_source==='unknown'?'unknown':x.open_source?'Yes':'No'],['GitHub stars',x=>fmt(x.stats.stars)],['Latest version',x=>x.stats.display_version?`${x.stats.display_version} (${x.stats.display_version_source})`:'—'],['Release date',x=>d(x.stats.release_date)],['PyPI / week',x=>fmt(x.stats.pypi_last_week)],['npm / week',x=>fmt(x.stats.npm_last_week)],['Last push',x=>d(x.stats.pushed_at)],['Verification',x=>x.status]];
const brk=x=>breaking.filter(r=>r.slug===x.slug&&Date.now()-new Date(r.date)<84*864e5).length;
const kind=a.category==='personal'?'price and plans':a.category==='managed'?'pricing and what you get':'popularity, updates and cost';
const guide=[a.slug,b.slug].some(x=>x==='chatgpt-dots'||x==='gemini-agent')?['/chatgpt-vs-gemini/','ChatGPT vs Gemini: the full guide (prices, agents, privacy)']:null;
const desc=`${a.name} vs ${b.name} (${new Date().getFullYear()}): ${kind} side by side — ${u(a.pricing).slice(0,60)} vs ${u(b.pricing).slice(0,60)}. Every fact sourced, updated daily.`;
---
<Base title={`${a.name} vs ${b.name}: ${kind} compared | AgentStackWatch`} desc={desc.slice(0,300)}>
<header class="pagehead"><p class="kicker">Compare</p><h1>{a.name} vs {b.name}</h1><p class="dek">A plain side-by-side, updated every day from official sources. We don't pick a winner; the right choice depends on what you need.</p></header>
<div class="panel"><table class="cmp"><tr><th></th><th><a href={`/agents/${a.slug}/`}>{a.name}</a></th><th><a href={`/agents/${b.slug}/`}>{b.name}</a></th></tr>
{rows.map(([k,f])=> <tr><th>{k}</th><td>{f(a)}</td><td>{f(b)}</td></tr>)}
<tr><th>Updates that may need attention (12 weeks)</th><td>{a.github?brk(a):'—'}</td><td>{b.github?brk(b):'—'}</td></tr>
<tr><th>Pricing source</th>{[a,b].map(x=>{const url=pricing[x.slug]?.url||x.sources[0];return <td>{url?<a href={url}>{url.replace(/^https?:\/\//,'').slice(0,48)}</a>:'unknown'}</td>})}</tr>
<tr><th>What it is</th><td>{a.description}</td><td>{b.description}</td></tr></table></div><Signup variant="inline"/>
{guide && <p class="small">Related guide: <a href={guide[0]}>{guide[1]}</a></p>}
<p class="muted small">More: <a href="/compare/">all comparisons</a> · <a href="/guide/">the buyer's guide</a> · <a href="/pricing/">pricing</a> and <a href="/breaking/">breaking changes</a>. Badges and facts link to sources on each agent page.</p></Base>
