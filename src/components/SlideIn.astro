---
// Exit-intent / 50%-scroll signup slide-in. Dismissal remembered 7 days in localStorage; never on a phone's first page view.
---
<aside id="asw-si" class="asw-si" role="dialog" aria-label="Free buyer's guide and quiz" hidden>
 <button class="si-x" type="button" aria-label="Close">×</button>
 <p class="si-k">Free · no spam</p>
 <p class="si-t">Get the free AI Agent Buyer's Guide and a weekly agent briefing</p>
 <p class="si-d">One email a week with hands-on agent tests. Not sure where to start? Take the 1-minute quiz.</p>
 <div class="si-b"><a class="si-p" href="https://loays-newsletter.beehiiv.com/subscribe" target="_blank" rel="noopener" data-si="sub">Subscribe free</a><a class="si-s" href="/quiz/" data-si="quiz">Take the quiz</a></div>
 <p class="si-g"><a href="/guide/" data-si="guide">Read the buyer's guide →</a></p>
</aside>
<style is:global>
.asw-si{position:fixed;right:20px;bottom:20px;z-index:60;width:340px;max-width:calc(100vw - 24px);box-sizing:border-box;background:var(--card,#fff);color:var(--ink);border:1px solid var(--line);border-top:3px solid var(--acc);border-radius:14px;padding:18px 18px 14px;box-shadow:0 12px 36px rgba(0,0,0,.16);transform:translateY(130%);opacity:0;transition:transform .35s ease,opacity .35s ease}
.asw-si.on{transform:none;opacity:1}.asw-si[hidden]{display:none}
.asw-si p{margin:0}.si-k{font:700 11px/1.2 var(--sans);letter-spacing:.08em;text-transform:uppercase;color:var(--acc)}.si-t{font:600 17px/1.35 var(--sans);margin:6px 28px 6px 0!important}.si-d{font:400 14px/1.5 var(--sans);color:var(--ink2)}
.si-b{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0 8px}.si-b a{flex:1 1 auto;text-align:center;font:600 14px/1.2 var(--sans);padding:11px 14px;border-radius:999px;text-decoration:none}
.si-p{background:var(--acc);color:#fff!important}.si-s{border:1px solid var(--line);color:var(--ink)!important}.si-g{font:400 13px/1.4 var(--sans)}.si-g a{text-decoration:underline}
.si-x{position:absolute;top:8px;right:10px;width:32px;height:32px;border:0;background:none;font-size:22px;line-height:1;color:var(--mut);cursor:pointer}
@media(max-width:520px){.asw-si{left:12px;right:12px;bottom:12px;width:auto;max-width:none}}
@media(prefers-reduced-motion:reduce){.asw-si{transition:none}}
</style>
<script is:inline>
(function(){try{
var K='asw_si_dismissed',W=7*864e5,el=document.getElementById('asw-si'),p=location.pathname;
if(!el||/^\/(newsletter|quiz)\//.test(p))return;
var d=+localStorage.getItem(K)||0;if(Date.now()-d<W)return;
var mob=window.matchMedia('(max-width:720px)').matches,n=(+sessionStorage.getItem('asw_pv')||0)+1;sessionStorage.setItem('asw_pv',n);
if(mob&&n<2)return; // not on a phone's first page view
var shown=false;function show(){if(shown)return;shown=true;el.hidden=false;requestAnimationFrame(function(){el.classList.add('on')});off()}
function close(){el.classList.remove('on');localStorage.setItem(K,Date.now());setTimeout(function(){el.hidden=true},400)}
function sc(){var h=document.documentElement;if((h.scrollTop+innerHeight)/h.scrollHeight>=.5)show()}
function ex(e){if(!e.relatedTarget&&e.clientY<=0)show()}
function off(){removeEventListener('scroll',sc);document.removeEventListener('mouseout',ex)}
addEventListener('scroll',sc,{passive:true});if(!mob)document.addEventListener('mouseout',ex);
el.querySelector('.si-x').onclick=close;document.addEventListener('keydown',function(e){if(e.key==='Escape'&&shown)close()});
el.querySelectorAll('[data-si]').forEach(function(a){a.addEventListener('click',function(){localStorage.setItem(K,Date.now())})});
}catch(e){}})();
</script>
