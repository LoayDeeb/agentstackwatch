---
// Exit-intent / 50%-scroll signup slide-in with the real form inside (mounted only when shown).
// Dismissal remembered 7 days in localStorage; never on a phone's first page view; never for subscribers.
import Signup from './Signup.astro';
---
<aside id="asw-si" class="asw-si" role="dialog" aria-label="Free AI agent cheat sheet" hidden>
 <button class="si-x" type="button" aria-label="Close">×</button>
 <p class="si-k">Free cheat sheet</p>
 <p class="si-t">Which AI agent should you actually pay for?</p>
 <p class="si-d">Get the 2-minute <b>Personal Agent Cheat Sheet</b>, plus one 5-minute email a week on what changed in ChatGPT, Claude, Grok &amp; co. and what to do about it.</p>
 <Signup variant="slide" />
 <p class="si-g">Rather click than type? <a href="/quiz/" data-si="quiz">Take the 1-minute quiz →</a></p>
</aside>
<style is:global>
.asw-si{position:fixed;right:20px;bottom:20px;z-index:60;width:380px;max-width:calc(100vw - 24px);max-height:calc(100vh - 40px);overflow:auto;box-sizing:border-box;background:var(--card,#fff);color:var(--ink);border:1px solid var(--line);border-top:3px solid var(--acc);border-radius:14px;padding:18px 18px 14px;box-shadow:0 12px 36px rgba(0,0,0,.16);transform:translateY(130%);opacity:0;transition:transform .35s ease,opacity .35s ease}
.asw-si.on{transform:none;opacity:1}.asw-si[hidden]{display:none}
.asw-si p{margin:0}.si-k{font:700 11px/1.2 var(--sans);letter-spacing:.08em;text-transform:uppercase;color:var(--acc)}.si-t{font:600 18px/1.3 var(--sans);margin:6px 28px 6px 0!important}.si-d{font:400 14px/1.5 var(--sans);color:var(--ink2);margin-bottom:12px!important}
.asw-si .signup{margin:0 0 8px}.si-g{font:400 13px/1.4 var(--sans);color:var(--mut)}.si-g a{text-decoration:underline;color:var(--ink)}
.si-x{position:absolute;top:8px;right:10px;width:32px;height:32px;border:0;background:none;font-size:22px;line-height:1;color:var(--mut);cursor:pointer}
@media(max-width:520px){.asw-si{left:12px;right:12px;bottom:12px;width:auto;max-width:none;padding:16px 16px 12px}.si-t{font-size:17px}.si-d{font-size:13.5px}}
@media(prefers-reduced-motion:reduce){.asw-si{transition:none}}
</style>
<script is:inline>
(function(){try{
var K='asw_si_dismissed',W=7*864e5,el=document.getElementById('asw-si'),p=location.pathname;
if(!el||/^\/(newsletter|quiz|cheat-sheet)\//.test(p))return;
if(window.aswSubscribed&&window.aswSubscribed())return;
var d=+localStorage.getItem(K)||0;if(Date.now()-d<W)return;
var mob=window.matchMedia('(max-width:720px)').matches,n=(+sessionStorage.getItem('asw_pv')||0)+1;sessionStorage.setItem('asw_pv',n);
if(mob&&n<2)return; // not on a phone's first page view
var shown=false;function show(){if(shown)return;if(window.aswSubscribed&&window.aswSubscribed())return;shown=true;el.hidden=false;var b=el.querySelector('.bh-embed');if(b&&window.aswMount)window.aswMount(b);requestAnimationFrame(function(){el.classList.add('on')});off()}
function close(){el.classList.remove('on');localStorage.setItem(K,Date.now());setTimeout(function(){el.hidden=true},400)}
function sc(){var h=document.documentElement;if((h.scrollTop+innerHeight)/h.scrollHeight>=.5)show()}
function ex(e){if(!e.relatedTarget&&e.clientY<=0)show()}
function off(){removeEventListener('scroll',sc);document.removeEventListener('mouseout',ex)}
addEventListener('scroll',sc,{passive:true});if(!mob)document.addEventListener('mouseout',ex);
el.querySelector('.si-x').onclick=close;document.addEventListener('keydown',function(e){if(e.key==='Escape'&&shown)close()});
el.querySelectorAll('[data-si]').forEach(function(a){a.addEventListener('click',function(){localStorage.setItem(K,Date.now())})});
}catch(e){}})();
</script>
