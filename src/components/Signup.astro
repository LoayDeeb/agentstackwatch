---
// Newsletter signup. The Beehiiv form is mounted lazily by the shared script in Base.astro
// (window.aswMount), which also crops Beehiiv's duplicate header and handles the success state.
interface Props { variant?: 'inline' | 'feature' | 'hero' | 'slide' | 'quiz'; kicker?: string; title?: string; text?: string; eager?: boolean; points?: boolean }
const v = Astro.props.variant ?? 'inline';
const defaults = {
  inline: { kicker: 'Free · 1 email a week', title: 'Not sure which AI agent to pay for? Get the 2-minute cheat sheet.' },
  feature: { kicker: 'The weekly briefing · free', title: 'Know which AI agent is worth paying for, every week.' },
  hero: { kicker: '', title: '' },
  slide: { kicker: '', title: '' },
  quiz: { kicker: 'Keep your pick up to date', title: 'Get your personalized pick + weekly updates.' },
};
const kicker = Astro.props.kicker ?? defaults[v].kicker;
const title = Astro.props.title ?? defaults[v].title;
const text = Astro.props.text;
const points = Astro.props.points ?? (v !== 'hero' && v !== 'slide');
const eager = Astro.props.eager ?? false;
---
<section class={`signup v-${v}${v === 'feature' || v === 'quiz' ? ' feature' : ''}`} data-asw-signup aria-label="Newsletter signup">
  {(kicker || title || text || points) && (
    <div class="sg-copy">
      {kicker && <p class="kicker">{kicker}</p>}
      {title && <h3>{title}</h3>}
      {text && <p class="sg-lead">{text}</p>}
      {points && (
        <ul class="sg-why">
          <li><b>The Personal Agent Cheat Sheet:</b> which AI agent to pay for, in 2 minutes.</li>
          <li><b>One 5-minute email a week:</b> what changed in ChatGPT, Claude, Grok &amp; co., and what to actually do.</li>
          {v !== 'inline' && <li>Plain English. Every fact links to the company's own page.</li>}
        </ul>
      )}
    </div>
  )}
  <div class="sg-form">
    <div class="bh-embed" data-eager={eager ? '1' : undefined}></div>
    <p class="sg-fine">Free. No spam, unsubscribe in one click. Written by Loay Deeb, AI agent architect.</p>
    <p class="sg-alt">Form not loading? <a href="https://loays-newsletter.beehiiv.com/subscribe" target="_blank" rel="noopener">Subscribe on our Beehiiv page →</a></p>
    <div class="sg-done" hidden role="status">✓ You're in. Your welcome email is on its way. Meanwhile: <a href="/cheat-sheet/">open your cheat sheet →</a></div>
  </div>
</section>
