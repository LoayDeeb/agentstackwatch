---
const { variant = 'inline' } = Astro.props;
---
<section class={`signup ${variant}`}>
 <div class="sg-copy"><p class="kicker">Agent Stack Weekly · free</p><h3>One email a week. Everything that shipped in AI agents.</h3>
 <p>Releases, pricing changes and breaking changes from the tracker, plus a short take from a working agent architect.</p></div>
 <div class="sg-form">
  <div class="bh-embed"><script is:inline async src="https://subscribe-forms.beehiiv.com/v3/loader.js" data-beehiiv-form="04a2cee6-b594-4905-820a-136cd592059d"></script></div>
  <p class="sg-alt">Form not loading? <a href="https://loays-newsletter.beehiiv.com/subscribe" target="_blank" rel="noopener">Subscribe on Beehiiv →</a></p>
 </div>
</section>
<script is:inline>
(function(){var sec=document.currentScript.previousElementSibling,f=sec.querySelector('.sg-form'),box=f.querySelector('.bh-embed'),t=Date.now();
// Beehiiv's iframe has a fixed 80px inner padding. On phones we render it wider, then scale it down so it fits the screen exactly (no box wider than the viewport).
function fit(){var fr=box.querySelector('iframe');if(!fr)return;var st=fr.style;
 if(window.innerWidth>520){['width','max-width','margin','transform','transform-origin'].forEach(function(k){st.removeProperty(k)});box.style.height='';return}
 var vw=document.documentElement.clientWidth,left=box.getBoundingClientRect().left,W=vw+58,k=vw/W;
 st.setProperty('width',W+'px','important');st.setProperty('max-width','none','important');st.setProperty('margin','0','important');
 st.setProperty('transform-origin','0 0','important');st.setProperty('transform','translate('+(-left)+'px,'+(-62*k)+'px) scale('+k+')','important');
 var h=fr.offsetHeight;if(h)box.style.height=Math.max(60,(h-62-66)*k)+'px'}
(function c(){var fr=box.querySelector('iframe');if(fr){fit();try{new ResizeObserver(fit).observe(fr);new MutationObserver(function(){if(!/scale/.test(fr.getAttribute('style')||''))fit()}).observe(fr,{attributes:true,attributeFilter:['style']})}catch(e){}window.addEventListener('resize',fit);return}
 if(Date.now()-t>8000){f.classList.add('bh-failed');return}setTimeout(c,400)})();})();
</script>
